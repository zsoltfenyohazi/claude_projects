# Copy to .env (never commit it). Only ANTHROPIC_API_KEY is needed for a first dry run.
ANTHROPIC_API_KEY=
ALFRED_CONFIG=config/family.yaml
ALFRED_DATA_DIR=data
ALFRED_DRY_RUN=0

# WhatsApp Cloud API (Meta for Developers > your app > WhatsApp > API setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=choose-a-long-random-string
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_NAME=alfred_notice

# Alfred's OWN mailbox for sending notes to the family (e.g. a new Gmail account with an app password)
ALFRED_SMTP_HOST=smtp.gmail.com
ALFRED_SMTP_PORT=587
ALFRED_SMTP_USER=
ALFRED_SMTP_PASSWORD=
ALFRED_FROM_EMAIL=

# iCloud app-specific passwords (appleid.apple.com > Sign-In and Security > App-Specific Passwords)
ICLOUD_PASSWORD_MUM=

# Optional
NS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
